{
  // "Keen 4 (Windows)" plays the cross-compiled build on Windows.
  // Every config wipes its build folder first, then builds from scratch.
  // "Keen 4" builds the debug preset and starts the game under gdb.
  // Ctrl+F5 runs the same config without the debugger.
  // The game runs from the repository root, so it finds ./gamedata and ./art on its own.
  "version": "0.2.0",
  "configurations": [
    {
      // Cleans and builds keen4.exe in WSL and plays it on the Windows host. No breakpoints:
      // use the configs below to debug the Linux build under gdb.
      "name": "Keen 4 (Windows)",
      "type": "node-terminal",
      "request": "launch",
      "command": "./build/windows/keen4.exe",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "clean build windows"
    },
    {
      "name": "Keen 4",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/keen4",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "clean build debug",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Keen 4 (classic 320x200)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/keen4",
      "args": ["--classic"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "clean build debug",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Keen 4 (jump to level)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/keen4",
      "args": ["/TEDLEVEL", "${input:level}", "${input:difficulty}"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "clean build debug",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Keen 4 (release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/release/keen4",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "clean build release",
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ],
  "inputs": [
    {
      "id": "level",
      "type": "promptString",
      "description": "Level number (0 is the world map)",
      "default": "1"
    },
    {
      "id": "difficulty",
      "type": "pickString",
      "description": "Difficulty",
      "options": ["EASY", "NORMAL", "HARD"],
      "default": "NORMAL"
    }
  ]
}
