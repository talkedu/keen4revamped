{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "binaryDir": "build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "binaryDir": "build/asan",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows (cross-compiled with MinGW-w64)",
      "binaryDir": "build/windows",
      "toolchainFile": "${sourceDir}/cmake/mingw-w64-x86_64.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KEEN4_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "anbernic",
      "displayName": "Linux aarch64 handhelds (cross-compiled with Zig, see packaging/anbernic)",
      "binaryDir": "build/anbernic",
      "toolchainFile": "${sourceDir}/cmake/aarch64-linux-zig.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KEEN4_BUILD_TESTS": "OFF",
        "SDL_X11": "OFF",
        "SDL_PIPEWIRE": "OFF",
        "SDL_JACK": "OFF",
        "SDL_SNDIO": "OFF",
        "SDL_LIBURING": "OFF",
        "SDL_WAYLAND_LIBDECOR": "OFF",
        "SDL_VULKAN": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug"
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross",
      "configuration": "Release"
    },
    {
      "name": "anbernic",
      "configurePreset": "anbernic",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "configuration": "Debug"
    }
  ]
}
